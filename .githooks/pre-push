#!/bin/sh
# Runs before every git push. Blocks push if tests fail.
# Enable once: git config core.hooksPath .githooks
set -e
# Parallel compile (and lint overlapping the tests). Override with JOBS=1 for
# readable, non-interleaved output. Portable across macOS and Linux.
JOBS="${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)}"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# What the change can affect (scripts/changed-scope.sh: docs, web or full;
# GATES_SCOPE=full forces the full run).
SCOPE="$(./scripts/changed-scope.sh)"
case "$SCOPE" in
docs)
	echo "pre-push: docs-only change, skipping tests"
	exit 0
	;;
web)
	echo "pre-push: webui-only change, running the web unit tests..."
	cd webui && npm test -- --run
	exit $?
	;;
esac

# make gates already passed for exactly this commit on a clean tree.
STAMP="build/gates/passed"
if [ -z "$(git status --porcelain -uall)" ] && [ -f "$STAMP" ] &&
		[ "$(cat "$STAMP")" = "$(git rev-parse HEAD)" ]; then
	echo "pre-push: make gates already passed for $(git rev-parse --short HEAD), skipping"
	exit 0
fi

# Commits being pushed (empty when upstream not set yet)
RANGE="@{u}..HEAD"
if ! git rev-parse --verify "$RANGE" >/dev/null 2>&1; then
	RANGE="HEAD"
fi

CHANGED="$(git diff --name-only "$RANGE" 2>/dev/null || true)"
needs_clean=0
if printf '%s\n' "$CHANGED" | grep -qE '^(Makefile|test/)'; then
	needs_clean=1
fi

if [ "$needs_clean" -eq 1 ]; then
	echo "pre-push: Makefile or test/** changed — clean build (CI parity)..."
	make distclean
	echo "pre-push: running PIANOBAR_INTEGRATION=1 PIANOBAR_TEST_NO_DEVICE=1 make -j$JOBS test-all..."
	PIANOBAR_INTEGRATION=1 PIANOBAR_TEST_NO_DEVICE=1 make -j"$JOBS" test-all
else
	echo "pre-push: running make -j$JOBS test-all..."
	make -j"$JOBS" test-all
fi
